# iOS build / sign / TestFlight pipeline for the Capacitor shell.
#
# The web app is built separately (`npm run build:native` -> `out/`) and copied
# into the native project by `npx cap sync ios` BEFORE any lane here runs --
# see .github/workflows/ios.yml. These lanes only touch the Xcode side.
#
# Auth is an App Store Connect API key (no Apple ID, no 2FA). Signing assets
# come from `match` (fastlane/Matchfile) -- a private encrypted git repo of the
# distribution cert + provisioning profile. Secrets are documented in
# ios/README.md.

default_platform(:ios)

XCODEPROJ    = "ios/App/App.xcodeproj"
SCHEME       = "App"
BUNDLE_ID    = "net.worldofmythos.game"
PROFILE_NAME = "match AppStore #{BUNDLE_ID}"
OUTPUT_DIR   = "ios/output"

# App version (CFBundleShortVersionString) and build number (CFBundleVersion)
# are injected at archive time from the git-derived values the workflow passes
# as APP_VERSION / BUILD_NUMBER -- same source as the web build's
# NEXT_PUBLIC_APP_VERSION / NEXT_PUBLIC_BUILD_NUMBER
# (docs/MOBILE_AND_STEAM_PLAN.md §4.2). No file is mutated: the values are
# passed as xcodebuild build settings and Info.plist's $(MARKETING_VERSION) /
# $(CURRENT_PROJECT_VERSION) resolve from them.
def version_xcargs
  parts = ["-skipPackagePluginValidation", "-skipMacroValidation"]
  parts << "MARKETING_VERSION=#{ENV['APP_VERSION']}" if ENV["APP_VERSION"].to_s != ""
  parts << "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']}" if ENV["BUILD_NUMBER"].to_s != ""
  parts.join(" ")
end

def load_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
    is_key_content_base64: false,
    in_house: false,
  )
end

platform :ios do
  # PR / not-yet-configured path: prove the Capacitor project still compiles on
  # a macOS runner. No secrets, no signing, no upload.
  desc "Compile-only build with signing disabled (CI smoke test)"
  lane :build_unsigned do
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      skip_archive: true,
      skip_codesigning: true,
      destination: "generic/platform=iOS",
      xcargs: "#{version_xcargs} CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO",
      output_directory: OUTPUT_DIR,
      buildlog_path: "#{OUTPUT_DIR}/logs",
    )
  end

  # One-off, run manually once via workflow_dispatch(bootstrap_certs: true)
  # after the secrets are set. Creates the distribution certificate + the
  # "match AppStore net.worldofmythos.game" provisioning profile and pushes
  # them (encrypted) into the MATCH_GIT_URL repo. Every later `beta` run is
  # readonly against what this produced.
  desc "One-time: create + push signing assets into the match repo"
  lane :bootstrap_certs do
    setup_ci
    load_api_key
    match(type: "appstore", app_identifier: BUNDLE_ID, readonly: false)
    UI.success("Signing assets are in the match repo. Future runs use `beta`.")
  end

  # Tag push / manual dispatch, once IOS_TESTFLIGHT_ENABLED=true and secrets
  # exist: sign with the match assets and upload to TestFlight.
  desc "Build a signed .ipa and upload it to TestFlight"
  lane :beta do
    setup_ci
    load_api_key

    match(type: "appstore", app_identifier: BUNDLE_ID, readonly: true)

    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: BUNDLE_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE_NAME,
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: version_xcargs,
      output_directory: OUTPUT_DIR,
      buildlog_path: "#{OUTPUT_DIR}/logs",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => PROFILE_NAME },
      },
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
    )
  end
end
