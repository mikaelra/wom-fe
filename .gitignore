# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# electron
/dist-electron/
# Steam SDK dev-only file: written at runtime by electron/steam.js, and a
# stray copy actively breaks launch detection in a shipped build.
/steam_appid.txt
# SteamPipe: rendered VDFs (real IDs, absolute paths) + build logs/cache
/steam/output/

# iOS / Capacitor -- the native project under ios/ is committed, but its build
# products, resolved SwiftPM checkout, synced web assets and generated config
# are not (ios/.gitignore covers most; these are belt-and-suspenders).
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/App/App/config.xml
/ios/App/build/
/ios/DerivedData/
/ios/output/
/ios/capacitor-cordova-ios-plugins/
/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
**/*.xcuserdatad/

# fastlane -- signing material must never be committed; certs live in the
# private match repo (ios/README.md).
/fastlane/report.xml
/fastlane/Preview.html
/fastlane/test_output/
*.p8
*.mobileprovision
*.p12
*.cer

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Steam upload credentials (App ID, depot IDs, build-account login) -- see
# steam/README.md. Not matched by .env* above.
.steam.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# /modelling prompt-box transcript (temporary dev page)
.modelling/
