# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# electron
/dist-electron/
# Steam SDK dev-only file: written at runtime by electron/steam.js, and a
# stray copy actively breaks launch detection in a shipped build.
/steam_appid.txt
# SteamPipe: rendered VDFs (real IDs, absolute paths) + build logs/cache
/steam/output/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Steam upload credentials (App ID, depot IDs, build-account login) -- see
# steam/README.md. Not matched by .env* above.
.steam.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# /modelling prompt-box transcript (temporary dev page)
.modelling/
